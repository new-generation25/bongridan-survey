# 봉리단길 설문앱 환경변수 설정

# ===== 데이터베이스 선택 =====
# 'firebase' 또는 'supabase'
DATABASE_PROVIDER=firebase

# ===== Firebase (권장 - 봉황메모리즈와 통합) =====
FIREBASE_PROJECT_ID=bonghwang-memories
# Firebase 서비스 계정 키 (JSON 문자열, 한 줄로)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ===== Supabase (기존 - 선택적) =====
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ===== JWT 인증 =====
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# ===== 쿠폰 설정 =====
NEXT_PUBLIC_COUPON_AMOUNT=500
NEXT_PUBLIC_COUPON_VALIDITY_HOURS=24
SETTLEMENT_RATE=700

# ===== 파트너 API 연동 (봉황메모리즈 등) =====
# 쉼표로 구분된 API 키 목록
PARTNER_API_KEYS=partner-api-key-1,partner-api-key-2

# 허용된 오리진 (추가 도메인)
ALLOWED_ORIGIN=https://your-partner-app.com
