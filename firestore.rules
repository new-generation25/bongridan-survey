rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 기본: 모든 접근 차단 (Admin SDK만 접근)
    match /{document=**} {
      allow read, write: if false;
    }

    // 가맹점 목록 - 읽기 허용 (앱에서 목록 표시용)
    match /stores/{storeId} {
      allow read: if resource.data.is_active == true;
      allow write: if false;
    }

    // 설정 - 읽기 허용 (쿠폰 금액 등 공개 설정)
    match /settings/{key} {
      allow read: if key in ['coupon_amount', 'coupon_validity_hours', 'survey_active'];
      allow write: if false;
    }
  }
}
